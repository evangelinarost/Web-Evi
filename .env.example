# Copiá este archivo como `.env.local` y completá los valores.
#   cp .env.example .env.local        (Mac/Linux/Git Bash)
#   copy .env.example .env.local      (Windows cmd)
# `.env.local` NO se sube a GitHub. Nunca pongas claves reales en este archivo.

# Clave de API de Resend (https://resend.com/api-keys). Empieza con "re_".
# Se usa en app/api/contact/route.ts para enviar los mensajes del formulario.
# Sin ella el formulario de contacto devuelve error.
RESEND_API_KEY=
